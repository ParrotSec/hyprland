+-- Parrot Cyberpunk — teal / midnight, using Hyprland's native Lua API.
+-- Super is the Windows/Command key. Super+F1 opens the offline guide.
+-- Personal overrides live in $XDG_CONFIG_HOME/hypr/local.lua and load last.
+-- This is the shared distribution default, loaded from /etc/xdg when present.
+-- Packaged builds can also load the same file directly from /usr/share/hypr.
+
+hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
+
+-- Start the Parrot desktop components after the compositor creates its sockets.
+-- The packages ship systemd user units, but they are not enabled by default;
+-- this is the single startup path for Hyprpaper, Waybar and Hypridle.
+local function run_if_present(path, argument)
+    local file = io.open(path, "r")
+    if not file then
+        return
+    end
+    file:close()
+    if argument then
+        hl.exec_cmd(path .. " " .. argument)
+    else
+        hl.exec_cmd(path)
+    end
+end
 
+local function file_exists(path)
+    local file = io.open(path, "r")
+    if not file then
+        return false
+    end
+    file:close()
+    return true
+end
 

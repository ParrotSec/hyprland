Description: Use std::visit instead of the C++26 member variant::visit
 libstdc++ 14 (gcc 14) has neither the C++26 member function
 std::variant::visit nor its std::visit member, so CKey::matches fails to
 compile. Spell it out as std::visit(visitor, variant), which is equivalent
 and works on both gcc 14 and 15+.
Origin: Parrot
Forwarded: not-needed
Last-Update: 2026-11-19
Index: hyprland-0.57.2+ds/src/keybinds/Key.cpp
===================================================================
--- hyprland-0.57.2+ds.orig/src/keybinds/Key.cpp
+++ hyprland-0.57.2+ds/src/keybinds/Key.cpp
@@ -77,7 +77,7 @@ bool CKey::matches(KeyEvent ev, xkb_stat
     if (empty())
         return false;
 
-    return ev.visit([&](auto&& value) {
+    return std::visit([&](auto&& value) {
         using T = std::decay_t<decltype(value)>;
         if constexpr (std::is_same_v<T, SKeysymPattern>)
             return m_sym && value.sym == *m_sym;
@@ -89,7 +89,7 @@ bool CKey::matches(KeyEvent ev, xkb_stat
             return m_event && value.ev == *m_event;
         else
             return false;
-    });
+    }, ev);
 }
 
 bool CKey::matches(const SResolvedKey& key) const {

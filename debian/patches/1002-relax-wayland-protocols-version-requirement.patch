Description: Accept wayland-protocols 1.47 instead of requiring 1.49
 wayland-protocols 1.47 is the newest release in the stable-backports suite,
 and it already contains every protocol XML that Hyprland 0.57 generates
 (including staging/pointer-warp and staging/ext-background-effect, which are
 what rule out 1.44). The only XML added between 1.47 and 1.49 is
 staging/xdg-session-management, which this version does not use.
Origin: Parrot
Forwarded: not-needed
Last-Update: 2026-11-19
Index: hyprland-0.57.2+ds/CMakeLists.txt
===================================================================
--- hyprland-0.57.2+ds.orig/CMakeLists.txt
+++ hyprland-0.57.2+ds/CMakeLists.txt
@@ -269,7 +269,7 @@ set_source_files_properties(${CMAKE_SOUR
 
 set(XKBCOMMON_MINIMUM_VERSION 1.11.0)
 set(WAYLAND_SERVER_MINIMUM_VERSION 1.22.91)
-set(WAYLAND_SERVER_PROTOCOLS_MINIMUM_VERSION 1.49)
+set(WAYLAND_SERVER_PROTOCOLS_MINIMUM_VERSION 1.47)
 set(LIBINPUT_MINIMUM_VERSION 1.28)
 
 pkg_check_modules(deps

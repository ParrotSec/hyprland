Description: Fix FTBFS with gcc 14: concatenating std::string and
 std::string_view
 P2591 (concatenation of std::string and std::string_view) is a C++26 library
 feature that Debian and Parrot's gcc 14 libstdc++ does not provide yet, so
 std::string{"0x"} + value fails to compile when value is a std::string_view.
 .
 Same workaround as the one Debian applied in the trixie backport of
 hyprland 0.55.2 (bpo.patch).
Origin: Parrot
Forwarded: not-needed
Last-Update: 2026-11-19
Index: hyprland-0.57.2+ds/src/config/shared/parserUtils/ParserUtils.cpp
===================================================================
--- hyprland-0.57.2+ds.orig/src/config/shared/parserUtils/ParserUtils.cpp
+++ hyprland-0.57.2+ds/src/config/shared/parserUtils/ParserUtils.cpp
@@ -14,7 +14,7 @@ using namespace Config::ParserUtils;
 using namespace Hyprutils::String;
 
 static std::expected<uint64_t, std::string> parseHex(std::string_view value) {
-    auto res = value.starts_with("0x") ? strToNumber<uint64_t>(value) : strToNumber<uint64_t>(std::string{"0x"} + value);
+    auto res = value.starts_with("0x") ? strToNumber<uint64_t>(value) : strToNumber<uint64_t>(std::string{"0x"} + std::string{value});
     if (!res)
         return std::unexpected(std::format("invalid hex \"{}\"", value));
     return *res;
